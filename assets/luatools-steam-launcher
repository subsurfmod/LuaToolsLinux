#!/usr/bin/env bash
# ==============================================================================
# LuaTools Linux — Steam Launcher Wrapper
# Launches 32-bit Steam preloading native 32-bit libsteam_integration.so
# (built for i686) via LD_PRELOAD instead of relying on 32-bit SLSsteam.so (LD_AUDIT).
#
# When 32-bit libsteam_integration.so is unavailable, safely strips 64-bit
# libsteam_integration.so from LD_PRELOAD and falls back to SLSsteam.so (LD_AUDIT).
#
# Supports --gdb and --lldb interactive debugger options.
# ==============================================================================
set -e

DEBUGGER=""
case "${1:-}" in
  --gdb)
    DEBUGGER="gdb"
    shift
    ;;
  --lldb)
    DEBUGGER="lldb"
    shift
    ;;
esac

# Strip any pre-existing libsteam_integration*.so from LD_PRELOAD cleanly,
# handling both colon- and whitespace-separated glibc LD_PRELOAD lists without globbing.
strip_bridge_preload() {
  (
    set -f
    local raw="${1:-}"
    local out=""
    local tok=""
    local IFS=$': \t\n'
    for tok in $raw; do
      case "$tok" in
        ""|*libsteam_integration.so|*libsteam_integration32.so|*libsteam_integration64.so)
          continue
          ;;
      esac
      out="${out:+${out}:}${tok}"
    done
    printf '%s' "$out"
  )
}

check_elf_arch() {
  local path="$1"
  local expected="$2"
  [ -f "$path" ] || return 1
  if command -v file >/dev/null 2>&1; then
    file -L "$path" 2>/dev/null | grep -q "$expected" || return 1
  fi
  return 0
}

is_valid_multilib_base() {
  local base="$1"
  check_elf_arch "${base}/lib/libsteam_integration.so" "ELF 32-bit" || return 1
  check_elf_arch "${base}/lib64/libsteam_integration.so" "ELF 64-bit" || return 1
  # On Debian/Ubuntu multiarch systems, glibc $LIB expands to lib/i386-linux-gnu & lib/x86_64-linux-gnu
  # (or i386-linux-gnu & x86_64-linux-gnu). Verify those paths resolve cleanly before exporting $LIB.
  if [ -d "/usr/lib/x86_64-linux-gnu" ] || [ -f "/etc/debian_version" ]; then
    check_elf_arch "${base}/lib/i386-linux-gnu/libsteam_integration.so" "ELF 32-bit" || return 1
    check_elf_arch "${base}/lib/x86_64-linux-gnu/libsteam_integration.so" "ELF 64-bit" || return 1
    check_elf_arch "${base}/i386-linux-gnu/libsteam_integration.so" "ELF 32-bit" || return 1
    check_elf_arch "${base}/x86_64-linux-gnu/libsteam_integration.so" "ELF 64-bit" || return 1
  fi
  return 0
}

# LT-20: Auto-launch LuaTools minimized in background unless user opted out
# Opt out via LUATOOLS_NO_AUTOLAUNCH=1 or creating ~/.config/luatools/no-autolaunch
if [ "${LUATOOLS_NO_AUTOLAUNCH:-0}" != "1" ] && [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/luatools/no-autolaunch" ]; then
  if command -v luatools >/dev/null 2>&1; then
    if ! pgrep -x luatools >/dev/null 2>&1; then
      luatools --minimized --tray-locked >/dev/null 2>&1 &
    fi
  elif [ -x "${HOME}/.local/bin/luatools" ]; then
    if ! pgrep -x luatools >/dev/null 2>&1; then
      "${HOME}/.local/bin/luatools" --minimized --tray-locked >/dev/null 2>&1 &
    fi
  fi
fi

# Strip any pre-existing libsteam_integration.so from LD_PRELOAD to avoid duplicates
if [ -n "${LD_PRELOAD:-}" ]; then
  CLEANED_PRELOAD="$(strip_bridge_preload "$LD_PRELOAD")"
  if [ -n "$CLEANED_PRELOAD" ]; then
    export LD_PRELOAD="$CLEANED_PRELOAD"
  else
    unset LD_PRELOAD
  fi
fi

# Locate integration library: prefer multilib $LIB if both 32-bit and 64-bit layout is verified
INTEGRATION_LIB=""
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || echo "")"

for base in \
  "${HOME}/.local/lib/luatools" \
  "/usr/local/lib/luatools" \
  "/usr/lib/luatools" \
  "${SCRIPT_DIR}/../dist"; do
  if is_valid_multilib_base "$base"; then
    INTEGRATION_LIB="${base}/\$LIB/libsteam_integration.so"
    break
  fi
done

if [ -z "$INTEGRATION_LIB" ]; then
  for cand in \
    "${HOME}/.local/lib/luatools/lib/libsteam_integration.so" \
    "${HOME}/.local/lib/luatools/32/libsteam_integration.so" \
    "${HOME}/.local/lib/luatools/libsteam_integration32.so" \
    "${HOME}/.local/lib/luatools/libsteam_integration.so" \
    "/usr/local/lib/luatools/lib/libsteam_integration.so" \
    "/usr/local/lib/luatools/32/libsteam_integration.so" \
    "/usr/local/lib/luatools/libsteam_integration32.so" \
    "/usr/local/lib/luatools/libsteam_integration.so" \
    "/usr/lib/luatools/lib/libsteam_integration.so" \
    "/usr/lib/luatools/32/libsteam_integration.so" \
    "/usr/lib/luatools/libsteam_integration32.so" \
    "/usr/lib/luatools/libsteam_integration.so" \
    "${SCRIPT_DIR}/../dist/lib/libsteam_integration.so" \
    "${SCRIPT_DIR}/../dist/32/libsteam_integration.so" \
    "${SCRIPT_DIR}/../dist/libsteam_integration32.so" \
    "${SCRIPT_DIR}/../dist/libsteam_integration.so" \
    "${SCRIPT_DIR}/../target/i686-unknown-linux-gnu/release/libsteam_integration.so"; do
    if check_elf_arch "$cand" "ELF 32-bit"; then
      INTEGRATION_LIB="$cand"
      break
    fi
  done
fi

# Locate Steam binary
STEAM_BIN=""
if [ -x "${HOME}/.local/share/Steam/steam.sh" ]; then
  STEAM_BIN="${HOME}/.local/share/Steam/steam.sh"
elif [ -x "${HOME}/.steam/steam/steam.sh" ]; then
  STEAM_BIN="${HOME}/.steam/steam/steam.sh"
elif command -v steam >/dev/null 2>&1; then
  STEAM_BIN="steam"
else
  STEAM_BIN="steam"
fi

# Primary launch path: when 32-bit libsteam_integration.so is available,
# inject via LD_PRELOAD and launch Steam directly without relying on SLSsteam.so (LD_AUDIT).
if [ -n "$INTEGRATION_LIB" ]; then
  export LD_PRELOAD="${INTEGRATION_LIB}${LD_PRELOAD:+:$LD_PRELOAD}"
  if [ "$DEBUGGER" = "gdb" ]; then
    exec gdb --args "$STEAM_BIN" "$@"
  elif [ "$DEBUGGER" = "lldb" ]; then
    exec lldb -- "$STEAM_BIN" "$@"
  else
    exec "$STEAM_BIN" "$@"
  fi
fi

# Fallback path: when 32-bit bridge_lib is absent, strip bridge libs from LD_PRELOAD
# and delegate to external 32-bit SLSsteam.so via steam-sls or LD_AUDIT
if [ -n "${LD_PRELOAD:-}" ]; then
  CLEANED_PRELOAD="$(strip_bridge_preload "$LD_PRELOAD")"
  if [ -n "$CLEANED_PRELOAD" ]; then
    export LD_PRELOAD="$CLEANED_PRELOAD"
  else
    unset LD_PRELOAD
  fi
fi

STEAM_SLS="${HOME}/.local/bin/steam-sls"
if [ -x "$STEAM_SLS" ]; then
  if [ "$DEBUGGER" = "gdb" ]; then
    exec gdb --args "$STEAM_SLS" "$@"
  elif [ "$DEBUGGER" = "lldb" ]; then
    exec lldb -- "$STEAM_SLS" "$@"
  else
    exec "$STEAM_SLS" "$@"
  fi
fi

# Fallback: locate SLSsteam.so in known locations and set LD_AUDIT
SLS_DIR=""
for cand in \
  "${HOME}/.local/lib/luatools/slssteam" \
  "${HOME}/.local/share/SLSsteam" \
  "/usr/local/lib/luatools/slssteam"; do
  if [ -f "${cand}/SLSsteam.so" ]; then
    SLS_DIR="$cand"
    break
  fi
done

if [ -n "$SLS_DIR" ]; then
  if [ -f "${SLS_DIR}/library-inject.so" ]; then
    AUDIT="${SLS_DIR}/library-inject.so:${SLS_DIR}/SLSsteam.so"
  else
    AUDIT="${SLS_DIR}/SLSsteam.so"
  fi
  export LD_AUDIT="${AUDIT}${LD_AUDIT:+:$LD_AUDIT}"
fi

if [ "$DEBUGGER" = "gdb" ]; then
  exec gdb --args "$STEAM_BIN" "$@"
elif [ "$DEBUGGER" = "lldb" ]; then
  exec lldb -- "$STEAM_BIN" "$@"
else
  exec "$STEAM_BIN" "$@"
fi
