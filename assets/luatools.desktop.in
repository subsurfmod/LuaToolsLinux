[Desktop Entry]
Version=1.0
Name=LuaTools Linux
GenericName=Steam Manifest & Lua Manager
Comment=Native Rust workstation for Steam stplug-in lua manifests, LuaVault variants, depots, and fixes
Exec="@EXEC_PATH@" %u
Icon=luatools
Terminal=false
Type=Application
Categories=Game;Utility;
MimeType=x-scheme-handler/luatools;x-scheme-handler/bst;
StartupWMClass=luatools
Keywords=Steam;LuaTools;Depots;Manifest;SLSsteam;Millennium;
