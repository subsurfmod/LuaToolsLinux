#!/usr/bin/env bash
# Standalone ticket dumper runner (BST-58)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

if [ -x "${REPO_ROOT}/target/release/extract_tickets" ]; then
    exec "${REPO_ROOT}/target/release/extract_tickets" "$@"
elif [ -x "${REPO_ROOT}/target/debug/extract_tickets" ]; then
    exec "${REPO_ROOT}/target/debug/extract_tickets" "$@"
else
    exec cargo run --bin extract_tickets --manifest-path "${REPO_ROOT}/Cargo.toml" -- "$@"
fi
